{
  "name": "herdr-ckd",
  "version": "0.2.0",
  "description": "Herdr CKD: Multi-Thread AI Orchestrator (1 Fixed Core Leader C + Parallel [A_n · B_n] Maker/Checker Thread Pairs) & Desktop Dashboard by AXNli Inc.",
  "author": {
    "name": "AXNli Inc. (주식회사 에이엑스엔엘아이)",
    "url": "https://axnli.com"
  },
  "homepage": "https://axnli.com",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "herdr-ckd": "dist/src/ui-server.js",
